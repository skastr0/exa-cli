{
  "name": "@skastr0/exa-cli",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "exa-cli": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run ./src/cli.ts",
    "build": "bun scripts/build.ts",
    "install:local": "bun scripts/install.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "bun run typecheck && bun run test && bun run build",
    "pack:dry-run": "npm pack --dry-run",
    "publish:dry-run": "bun publish --dry-run --access public"
  },
  "dependencies": {
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "license": "MIT",
  "description": "Effect-powered CLI for Exa search workflows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/exa-cli.git"
  },
  "homepage": "https://github.com/skastr0/exa-cli#readme",
  "bugs": {
    "url": "https://github.com/skastr0/exa-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
